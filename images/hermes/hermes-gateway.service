[Unit]
Description=Hermes Agent messaging gateway
Documentation=https://github.com/NousResearch/hermes-agent
PartOf=hermes.target

[Service]
Type=simple
WorkingDirectory=/sandbox
Environment=HOME=/sandbox
Environment=HERMES_HOME=/sandbox/.hermes
Environment=PATH=/opt/hermes/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/usr/local/lib/hermes/pythonpath
EnvironmentFile=-/sandbox/.hermes/user-systemd/workload.env
ExecStart=/opt/hermes/.venv/bin/hermes gateway run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=hermes.target
